{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://linkedin-skills.local/evolution/run-record.json", "title": "EvolutionRunRecord", "type": "object", "properties": {"run_id": {"type": "string"}, "skill_id": {"type": "string", "pattern": "^linkedin\\.[a-z0-9-]+$"}, "skill_version": {"type": "string"}, "input_hash": {"type": "string", "description": "Hash of inputs, never raw PII"}, "outcome": {"type": "string", "enum": ["succeeded", "partial", "failed", "refused"]}, "output_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "human_rating": {"type": "integer", "minimum": 1, "maximum": 5}, "downstream_reused": {"type": "boolean"}, "eval_passed": {"type": "boolean"}, "notes": {"type": "string", "maxLength": 1000}}, "required": ["run_id", "skill_id", "skill_version", "outcome", "notes"], "additionalProperties": false}
