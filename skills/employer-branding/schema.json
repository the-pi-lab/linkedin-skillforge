{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/employer-branding.json",
  "skill_id": "linkedin.employer-branding",
  "title": "LinkedIn Employer Branding",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "description": "Context + culture facts",
          "minLength": 1
        },
        "talent": {
          "type": "string",
          "description": "Who to attract/repel",
          "minLength": 1
        },
        "proof": {
          "type": "string",
          "description": "Stories, retention, growth data"
        }
      },
      "required": [
        "company",
        "talent"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Company)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.employer-branding"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}