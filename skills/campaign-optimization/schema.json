{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/campaign-optimization.json",
  "skill_id": "linkedin.campaign-optimization",
  "title": "LinkedIn Campaign Optimization",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "string",
          "description": "Impressions\u2192pipeline per variant",
          "minLength": 1
        },
        "structure": {
          "type": "string",
          "description": "Audiences + creatives + bids"
        },
        "goals": {
          "type": "string",
          "description": "CPL/CPA + volume targets",
          "minLength": 1
        }
      },
      "required": [
        "metrics",
        "goals"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Campaign)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.campaign-optimization"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}