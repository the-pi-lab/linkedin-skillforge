{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/content-scheduling.json",
  "skill_id": "linkedin.content-scheduling",
  "title": "LinkedIn Content Scheduling",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "posts": {
          "type": "string",
          "description": "Approved ContentPost[]",
          "minLength": 1
        },
        "windows": {
          "type": "string",
          "description": "Audience active hours + frequency cap",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Blackout dates, employer rules"
        }
      },
      "required": [
        "posts",
        "windows"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (ContentPost)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.content-scheduling"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}