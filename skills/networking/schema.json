{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/networking.json",
  "skill_id": "linkedin.networking",
  "title": "LinkedIn Networking",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "goals": {
          "type": "string",
          "description": "What relationships for (referrals, learning, hiring)",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "description": "Current network + bridges"
        },
        "capacity": {
          "type": "string",
          "description": "Touches/week"
        }
      },
      "required": [
        "goals"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Engagement)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.networking"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}