{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/lead-qualification.json",
  "skill_id": "linkedin.lead-qualification",
  "title": "LinkedIn Lead Qualification",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "leads": {
          "type": "string",
          "description": "Lead[] + dossiers/enrichment",
          "minLength": 1
        },
        "icp": {
          "type": "string",
          "description": "ICP entity",
          "minLength": 1
        },
        "signals": {
          "type": "string",
          "description": "Intent evidence + recency"
        },
        "capacity": {
          "type": "string",
          "description": "Follow-up bandwidth"
        }
      },
      "required": [
        "leads",
        "icp"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Prospect)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.lead-qualification"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}