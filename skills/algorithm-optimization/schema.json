{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/algorithm-optimization.json",
  "skill_id": "linkedin.algorithm-optimization",
  "title": "LinkedIn Algorithm Optimization",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "posts": {
          "type": "string",
          "description": "Recent posts + metrics",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "description": "Active hours, segments"
        },
        "goals": {
          "type": "string",
          "description": "Reach, conversations, leads"
        }
      },
      "required": [
        "posts"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (AnalyticsReport)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.algorithm-optimization"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}