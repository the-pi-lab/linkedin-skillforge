{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/conversion-tracking.json",
  "skill_id": "linkedin.conversion-tracking",
  "title": "LinkedIn Conversion Tracking",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "motions": {
          "type": "string",
          "description": "Content/outreach/ads/hiring in scope",
          "minLength": 1
        },
        "systems": {
          "type": "string",
          "description": "CRM + site + ad accounts",
          "minLength": 1
        },
        "goals": {
          "type": "string",
          "description": "CPA/ROAS/pipeline definitions",
          "minLength": 1
        }
      },
      "required": [
        "motions",
        "systems",
        "goals"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (AnalyticsReport)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.conversion-tracking"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}