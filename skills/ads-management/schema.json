{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/ads-management.json",
  "skill_id": "linkedin.ads-management",
  "title": "LinkedIn Ads Management",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "offer": {
          "type": "string",
          "description": "Value + landing + CTA",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "description": "ICP + exclusions + geos",
          "minLength": 1
        },
        "budget": {
          "type": "string",
          "description": "Total + test caps",
          "minLength": 1
        },
        "proof": {
          "type": "string",
          "description": "Compliant evidence"
        }
      },
      "required": [
        "offer",
        "audience",
        "budget"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Campaign)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.ads-management"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}