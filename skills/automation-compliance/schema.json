{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/automation-compliance.json",
  "skill_id": "linkedin.automation-compliance",
  "title": "LinkedIn Automation Compliance",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Proposed steps + tools + volumes",
          "minLength": 1
        },
        "policies": {
          "type": "string",
          "description": "Which rule sets apply (platform + regional)"
        },
        "context": {
          "type": "string",
          "description": "Consent, data, approval modes"
        }
      },
      "required": [
        "workflow"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (AutomationWorkflow)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.automation-compliance"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}