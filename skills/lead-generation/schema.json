{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/lead-generation.json",
  "skill_id": "linkedin.lead-generation",
  "title": "LinkedIn Lead Generation",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "offer": {
          "type": "string",
          "description": "What you sell + proof",
          "minLength": 1
        },
        "icp_hints": {
          "type": "string",
          "description": "Industries, titles, geos, dealbreakers",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Geos, blacklists, caps"
        },
        "sources": {
          "type": "string",
          "description": "Where leads may come from"
        }
      },
      "required": [
        "offer",
        "icp_hints"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Lead)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.lead-generation"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}