{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/job-search-optimization.json",
  "skill_id": "linkedin.job-search-optimization",
  "title": "LinkedIn Job Search Optimization",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "description": "Profile + experience + proof",
          "minLength": 1
        },
        "targets": {
          "type": "string",
          "description": "Roles, companies, geos, comp",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Timeline, visa, remote"
        }
      },
      "required": [
        "background",
        "targets"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (JobRole)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.job-search-optimization"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}