{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/outreach-automation.json",
  "skill_id": "linkedin.outreach-automation",
  "title": "LinkedIn Outreach Automation",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "description": "Prospect tiers + triggers",
          "minLength": 1
        },
        "offer": {
          "type": "string",
          "description": "Value + CTA",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Daily caps, tones, blacklists",
          "minLength": 1
        },
        "approval_mode": {
          "type": "string",
          "description": "human-gate | autonomous-logged"
        }
      },
      "required": [
        "audience",
        "offer",
        "constraints"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Campaign)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.outreach-automation"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}