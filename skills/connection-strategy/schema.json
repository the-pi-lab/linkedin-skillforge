{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/connection-strategy.json",
  "skill_id": "linkedin.connection-strategy",
  "title": "LinkedIn Connection Strategy",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "description": "ICP/tiers + triggers",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "description": "Requests/day + total goal"
        },
        "context": {
          "type": "string",
          "description": "Why connect now (shared trigger)"
        },
        "constraints": {
          "type": "string",
          "description": "Blacklists, employer rules"
        }
      },
      "required": [
        "audience"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Engagement)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.connection-strategy"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}