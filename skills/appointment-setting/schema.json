{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/appointment-setting.json",
  "skill_id": "linkedin.appointment-setting",
  "title": "LinkedIn Appointment Setting",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "conversation": {
          "type": "string",
          "description": "Thread state + prospect context",
          "minLength": 1
        },
        "offer": {
          "type": "string",
          "description": "Meeting value + agenda"
        },
        "calendar": {
          "type": "string",
          "description": "Availability + booking rules",
          "minLength": 1
        }
      },
      "required": [
        "conversation",
        "calendar"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Appointment)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.appointment-setting"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}