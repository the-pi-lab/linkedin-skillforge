{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/personal-branding.json",
  "skill_id": "linkedin.personal-branding",
  "title": "LinkedIn Personal Branding",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "description": "Profile audit, experience, proof points",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "description": "Who to attract/repel",
          "minLength": 1
        },
        "goals": {
          "type": "string",
          "description": "90-day brand outcomes",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Topics to avoid, employer sensitivities"
        },
        "examples": {
          "type": "string",
          "description": "Posts/profiles whose style fits"
        }
      },
      "required": [
        "background",
        "audience",
        "goals"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (LinkedInProfile)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.personal-branding"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}