{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/growth-strategy.json",
  "skill_id": "linkedin.growth-strategy",
  "title": "LinkedIn Growth Strategy",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "description": "Audits, reports, funnel metrics",
          "minLength": 1
        },
        "goals": {
          "type": "string",
          "description": "90-day outcomes + constraints",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "description": "Hours/budget available",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "goals",
        "capacity"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (AnalyticsReport)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.growth-strategy"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}