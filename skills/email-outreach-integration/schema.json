{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/email-outreach-integration.json",
  "skill_id": "linkedin.email-outreach-integration",
  "title": "LinkedIn Email Outreach Integration",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "description": "Prospects + consent basis",
          "minLength": 1
        },
        "assets": {
          "type": "string",
          "description": "Messages per channel",
          "minLength": 1
        },
        "infra": {
          "type": "string",
          "description": "Domains, tools, limits"
        }
      },
      "required": [
        "audience",
        "assets"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Campaign)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.email-outreach-integration"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}