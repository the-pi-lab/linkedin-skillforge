{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/sales-funnel.json",
  "skill_id": "linkedin.sales-funnel",
  "title": "LinkedIn Sales Funnel Building",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "motion": {
          "type": "string",
          "description": "Outbound/inbound/hybrid + ACV",
          "minLength": 1
        },
        "stages_current": {
          "type": "string",
          "description": "Existing stages if any"
        },
        "capacity": {
          "type": "string",
          "description": "SDR/AE bandwidth"
        },
        "crm": {
          "type": "string",
          "description": "CRM stage mapping"
        }
      },
      "required": [
        "motion"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Opportunity)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.sales-funnel"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}