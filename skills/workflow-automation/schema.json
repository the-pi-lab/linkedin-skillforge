{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/workflow-automation.json",
  "skill_id": "linkedin.workflow-automation",
  "title": "LinkedIn Workflow Automation",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "process": {
          "type": "string",
          "description": "As-is steps + volume",
          "minLength": 1
        },
        "systems": {
          "type": "string",
          "description": "Tools/CRMs involved",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Caps, approvals, SLAs",
          "minLength": 1
        }
      },
      "required": [
        "process",
        "systems",
        "constraints"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (AutomationWorkflow)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.workflow-automation"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}