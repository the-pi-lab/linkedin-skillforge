{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/engagement-strategy.json",
  "skill_id": "linkedin.engagement-strategy",
  "title": "LinkedIn Engagement Strategy",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "goals": {
          "type": "string",
          "description": "Pipeline, brand, or network goals",
          "minLength": 1
        },
        "targets": {
          "type": "string",
          "description": "Accounts/creators/prospects",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "description": "Comment voice + examples"
        },
        "capacity": {
          "type": "string",
          "description": "Minutes/day"
        }
      },
      "required": [
        "goals",
        "targets"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Engagement)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.engagement-strategy"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}