{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/recruitment-automation.json",
  "skill_id": "linkedin.recruitment-automation",
  "title": "LinkedIn Recruitment Automation",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "JD + team context",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Location, comp bands, timeline",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "description": "Interview + data policies"
        }
      },
      "required": [
        "role",
        "constraints"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (JobRole)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.recruitment-automation"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}