{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/copywriting.json",
  "skill_id": "linkedin.copywriting",
  "title": "LinkedIn Copywriting",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "string",
          "description": "Raw draft or brief",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "description": "Samples or voice rules"
        },
        "goal": {
          "type": "string",
          "description": "Engagement, leads, authority, hiring"
        },
        "constraints": {
          "type": "string",
          "description": "Length, hashtags, employer rules"
        }
      },
      "required": [
        "draft"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (ContentPost)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.copywriting"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}