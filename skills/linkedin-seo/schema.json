{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/linkedin-seo.json",
  "skill_id": "linkedin.linkedin-seo",
  "title": "LinkedIn SEO",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "description": "Who searches + what they type",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "description": "Current sections",
          "minLength": 1
        },
        "goals": {
          "type": "string",
          "description": "Inbound type sought"
        },
        "competitors": {
          "type": "string",
          "description": "Peer profiles ranking well"
        }
      },
      "required": [
        "audience",
        "profile"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (LinkedInProfile)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.linkedin-seo"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}