{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/social-selling.json",
  "skill_id": "linkedin.social-selling",
  "title": "LinkedIn Social Selling",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "string",
          "description": "Target accounts/personas",
          "minLength": 1
        },
        "triggers": {
          "type": "string",
          "description": "Signals to watch"
        },
        "offer": {
          "type": "string",
          "description": "Value + discovery CTA",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "description": "Comment voice rules"
        }
      },
      "required": [
        "accounts",
        "offer"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Conversation)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.social-selling"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}