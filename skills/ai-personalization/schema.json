{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/ai-personalization.json",
  "skill_id": "linkedin.ai-personalization",
  "title": "LinkedIn AI-Powered Personalization",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "description": "Message with {{slots}}",
          "minLength": 1
        },
        "dossiers": {
          "type": "string",
          "description": "ResearchResult[] per prospect",
          "minLength": 1
        },
        "rules": {
          "type": "string",
          "description": "Fill/hold thresholds, tone"
        },
        "batch_size": {
          "type": "string",
          "description": "Prospects per run"
        }
      },
      "required": [
        "template",
        "dossiers"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Message)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.ai-personalization"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}