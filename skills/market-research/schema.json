{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/market-research.json",
  "skill_id": "linkedin.market-research",
  "title": "LinkedIn Market Research",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "Market/domain + geos",
          "minLength": 1
        },
        "questions": {
          "type": "string",
          "description": "What must be decided",
          "minLength": 1
        },
        "sources_allowed": {
          "type": "string",
          "description": "profile | company | web"
        }
      },
      "required": [
        "domain",
        "questions"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (ResearchResult)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.market-research"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}