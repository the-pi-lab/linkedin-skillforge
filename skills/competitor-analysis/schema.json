{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/competitor-analysis.json",
  "skill_id": "linkedin.competitor-analysis",
  "title": "LinkedIn Competitor Analysis",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "competitors": {
          "type": "string",
          "description": "Named rivals + handles",
          "minLength": 1
        },
        "dimensions": {
          "type": "string",
          "description": "Positioning/content/engagement/proof"
        },
        "audience": {
          "type": "string",
          "description": "Shared buyer definition"
        }
      },
      "required": [
        "competitors"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (ResearchResult)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.competitor-analysis"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}