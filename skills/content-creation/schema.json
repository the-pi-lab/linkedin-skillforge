{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/content-creation.json",
  "skill_id": "linkedin.content-creation",
  "title": "LinkedIn Content Creation",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "pillars": {
          "type": "string",
          "description": "Brand pillars or topics",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "description": "Reader pains/context",
          "minLength": 1
        },
        "proof": {
          "type": "string",
          "description": "Available evidence, stories, data"
        },
        "constraints": {
          "type": "string",
          "description": "Banned topics, tone, employer rules"
        },
        "volume": {
          "type": "string",
          "description": "How many ideas/briefs"
        }
      },
      "required": [
        "pillars",
        "audience"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (ContentIdea)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.content-creation"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}