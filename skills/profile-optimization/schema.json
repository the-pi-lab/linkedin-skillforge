{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/profile-optimization.json",
  "skill_id": "linkedin.profile-optimization",
  "title": "LinkedIn Profile Optimization",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "profile_text": {
          "type": "string",
          "description": "Current headline + about + 2-3 experience entries (paste or handle)",
          "minLength": 1
        },
        "target_audience": {
          "type": "string",
          "description": "Who should convert (hiring manager, buyer, peer)",
          "minLength": 1
        },
        "target_outcome": {
          "type": "string",
          "description": "Job search, inbound leads, speaking, credibility",
          "minLength": 1
        },
        "proof_points": {
          "type": "string",
          "description": "Measurable results, links, credentials"
        },
        "tone": {
          "type": "string",
          "description": "Professional voice constraints"
        }
      },
      "required": [
        "profile_text",
        "target_audience",
        "target_outcome"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (LinkedInProfile)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.profile-optimization"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}