{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/api-integration.json",
  "skill_id": "linkedin.api-integration",
  "title": "LinkedIn API Integration",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Desired operations + volume",
          "minLength": 1
        },
        "stack": {
          "type": "string",
          "description": "Languages, hosts, stores",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "description": "Compliance,partner status"
        }
      },
      "required": [
        "workflow",
        "stack"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (AutomationWorkflow)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.api-integration"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}