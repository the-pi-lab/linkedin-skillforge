{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/ai-content-generation.json",
  "skill_id": "linkedin.ai-content-generation",
  "title": "LinkedIn AI Content Generation",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "brief": {
          "type": "string",
          "description": "Post brief or ContentIdea + proof",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "description": "Voice rules/samples"
        },
        "format": {
          "type": "string",
          "description": "text | carousel | poll | article"
        },
        "proof": {
          "type": "string",
          "description": "Evidence bundle"
        }
      },
      "required": [
        "brief"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (ContentPost)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.ai-content-generation"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}