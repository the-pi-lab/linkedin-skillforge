{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/abm.json",
  "skill_id": "linkedin.abm",
  "title": "LinkedIn Account-Based Marketing",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "string",
          "description": "Named accounts + context",
          "minLength": 1
        },
        "icp": {
          "type": "string",
          "description": "ICP + deal sizes",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "description": "Sales/marketing bandwidth"
        },
        "proof": {
          "type": "string",
          "description": "Proof per segment"
        }
      },
      "required": [
        "accounts",
        "icp"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Campaign)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.abm"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}