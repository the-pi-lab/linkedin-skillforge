{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedin-skills.local/skills/cold-messaging.json",
  "skill_id": "linkedin.cold-messaging",
  "title": "LinkedIn Cold Messaging",
  "type": "object",
  "properties": {
    "Input": {
      "type": "object",
      "properties": {
        "prospect": {
          "type": "string",
          "description": "Prospect/dossier + triggers",
          "minLength": 1
        },
        "offer": {
          "type": "string",
          "description": "Value + proof + CTA",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "description": "Voice + length limits"
        },
        "history": {
          "type": "string",
          "description": "Prior thread if reply"
        }
      },
      "required": [
        "prospect",
        "offer"
      ],
      "additionalProperties": true
    },
    "Output": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Skill entities (Message)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer_skill": {
              "const": "linkedin.cold-messaging"
            },
            "producer_version": {
              "type": "string"
            },
            "produced_at": {
              "type": "string"
            },
            "source_refs": {
              "type": "array"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gaps": {
              "type": "array"
            },
            "assumptions": {
              "type": "array"
            }
          },
          "required": [
            "producer_skill",
            "confidence",
            "gaps"
          ]
        }
      },
      "required": [
        "data",
        "provenance"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "Input",
    "Output"
  ]
}